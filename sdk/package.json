{
  "name": "@sillyfunc/launchpad-contracts",
  "version": "0.1.0",
  "description": "Type-safe ABIs and BSC deployment addresses for the SillyFunc token launchpad",
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "tsx scripts/generate.ts",
    "build": "pnpm generate && tsc -p tsconfig.json && tsc -p tsconfig.consumer.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.17.0",
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3"
  }
}
