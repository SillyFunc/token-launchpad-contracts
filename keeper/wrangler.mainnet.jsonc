{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sillyfunc-launchpad-keeper-mainnet",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "CHAIN_ID": "56",
    "KEEPER_ADDRESS": "0x0000000000000000000000000000000000000000",
    "DISCOVERY_PAGE_SIZE": "8",
    "MAX_ASSETS_PER_RUN": "8",
    "CHECK_INTERVAL_SECONDS": "60",
    "AMM_FEE_BPS": "25",
    "TAX_MAX_RESERVE_BPS": "30",
    "SLIPPAGE_BPS": "100",
    "MAX_PRICE_DEVIATION_BPS": "300",
    "ANCHOR_MIN_AGE_SECONDS": "300",
    "ANCHOR_MAX_AGE_SECONDS": "3600",
    "MIN_ANCHOR_SAMPLES": "3",
    "DEADLINE_SECONDS": "300",
    "GAS_PRICE_MULTIPLIER_BPS": "12000",
    "MAX_GAS_PRICE_WEI": "3000000000",
    "MIN_KEEPER_BALANCE_WEI": "10000000000000000",
    "PENDING_RETRY_SECONDS": "90"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sillyfunc-launchpad-keeper-mainnet",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SIGNER",
        "class_name": "SignerDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SignerDurableObject"]
    }
  ],
  "workflows": [
    {
      "name": "sillyfunc-launchpad-keeper-mainnet",
      "binding": "KEEPER_WORKFLOW",
      "class_name": "KeeperWorkflow"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
