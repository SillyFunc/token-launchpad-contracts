# Compiler files
cache/
out/

# Commonly ignored directories
.logs/
.ignore/

# Ignores development broadcast logs
!/broadcast
/broadcast/*/31337/
/broadcast/**/dry-run/
# Foundry keeps a timestamped copy for every broadcast attempt, including
# failed and resumed runs. Keep only the canonical *-latest.json files in Git.
/broadcast/**/run-[0-9]*.json

# Dotenv file
.env
.env.*
!.env.example

# Agent files
.zcode/
.workbuddy/

.ref_tmp/
.vscode/
.codegraph/
report.md

# Cloudflare keeper local state and secrets
/keeper/node_modules/
/keeper/.wrangler/
/keeper/.dev.vars
/keeper/worker-configuration.d.ts
